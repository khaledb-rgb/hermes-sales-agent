GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_COMPANY_ID=your_ghl_company_id_here

OPENAI_API_KEY=your_openai_api_key_here

# Optional: route LLM calls through OpenRouter instead of OpenAI directly.
# When OPENROUTER_API_KEY is set, Hermes uses it (DeepSeek V3.1 by default);
# leave it blank/unset to use OPENAI_API_KEY with gpt-4o / gpt-4o-mini.
OPENROUTER_API_KEY=
REPORT_MODEL=deepseek/deepseek-chat-v3.1
QA_MODEL=deepseek/deepseek-chat-v3.1
# LLM_BASE_URL=https://openrouter.ai/api/v1

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_owner_here
GITHUB_REPO=your_github_repo_here

# Calendly (optional, placeholder): set to enable Bookings / Show-rate KPIs.
CALENDLY_API_KEY=

# IANA timezone for report header date + footer timestamp (e.g. Africa/Cairo, Europe/London).
# Leave unset to use the server's local time.
REPORT_TIMEZONE=
